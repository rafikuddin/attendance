<?xml version="1.0" encoding="utf-8"?>
<!-- Pop-up dialogs: a soft rounded card in the app's surface colour (the 16dp inset keeps the same margin the system dialog had) -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp" android:insetRight="16dp" android:insetTop="16dp" android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <solid android:color="?attr/samSurface" />
        <corners android:radius="24dp" />
    </shape>
</inset>
