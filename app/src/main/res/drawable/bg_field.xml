<?xml version="1.0" encoding="utf-8"?>
<!-- The plain text boxes that the screens make in code (Admin Panel, pop-up forms, order forms, surveys): the same soft 14dp outline as the labelled fields
     (Widget.Sam.Field), so every box in the app looks like one family. The outline turns to the accent colour, thicker, while you type.
     The 4dp inset top and bottom leaves a small gap between boxes that are stacked one under the other (the screens add them without any margin). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/samSurface" />
                <stroke android:width="2dp" android:color="?attr/samAccent" />
                <corners android:radius="14dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/samSurface" />
                <stroke android:width="1dp" android:color="@color/field_line" />
                <corners android:radius="14dp" />
            </shape>
        </inset>
    </item>
</selector>
