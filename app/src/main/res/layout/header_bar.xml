<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_header" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="40dp" android:paddingBottom="28dp">
    <TextView android:id="@+id/btnBack" android:text="←" android:textSize="28sp"
        android:textColor="#FFFFFF" android:padding="8dp" android:clickable="true" android:focusable="true"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tvTitle" android:textSize="22sp" android:textStyle="bold"
        android:textColor="#FFFFFF" android:layout_marginStart="8dp"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
    <TextView android:id="@+id/btnRefresh" android:text="⟳" android:textSize="24sp" android:visibility="gone"
        android:textColor="#FFFFFF" android:padding="8dp" android:clickable="true" android:focusable="true"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
