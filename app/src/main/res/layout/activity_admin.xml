<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<!-- Fixed top: stays in place while the page below scrolls -->
<include layout="@layout/header_bar" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp">
    <TextView android:id="@+id/tabUsers" android:text="👥 Users" android:gravity="center"
        android:textSize="11sp" android:textStyle="bold" android:padding="8dp"
        android:layout_marginEnd="3dp" android:clickable="true" android:focusable="true"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tabNotices" android:text="📢 Notices" android:gravity="center"
        android:textSize="11sp" android:textStyle="bold" android:padding="8dp"
        android:layout_marginStart="1dp" android:layout_marginEnd="2dp" android:clickable="true" android:focusable="true"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tabHolidays" android:text="🎉 Holiday" android:gravity="center"
        android:textSize="11sp" android:textStyle="bold" android:padding="8dp"
        android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:clickable="true" android:focusable="true"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tabEntry" android:text="📝 Entry" android:gravity="center"
        android:textSize="11sp" android:textStyle="bold" android:padding="8dp"
        android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:clickable="true" android:focusable="true"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tabApp" android:text="📲 App" android:gravity="center"
        android:textSize="11sp" android:textStyle="bold" android:padding="8dp"
        android:layout_marginStart="3dp" android:clickable="true" android:focusable="true"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
</LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout android:id="@+id/adminContent" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="4dp" android:paddingBottom="24dp" />
</ScrollView>
<include layout="@layout/bottom_nav" />
</LinearLayout>
