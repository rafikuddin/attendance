<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_header" android:orientation="vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="40dp" android:paddingBottom="76dp">

            <!-- Brand row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <com.google.android.material.card.MaterialCardView
                    app:cardCornerRadius="10dp" app:cardElevation="0dp" app:cardBackgroundColor="#FFFFFF"
                    android:layout_width="34dp" android:layout_height="34dp">
                    <ImageView android:src="@drawable/logo" android:scaleType="centerCrop"
                        android:layout_width="match_parent" android:layout_height="match_parent" />
                </com.google.android.material.card.MaterialCardView>
                <TextView android:text="SAM BOND" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="24sp"
                    android:letterSpacing="0.03" android:layout_marginStart="10dp"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                <TextView android:id="@+id/btnRefresh" android:text="⟳" android:textSize="20sp"
                    android:textColor="#FFFFFF" android:background="@drawable/bg_icon_btn"
                    android:gravity="center" android:clickable="true" android:focusable="true"
                    android:layout_width="38dp" android:layout_height="38dp" />
                <TextView android:id="@+id/btnMenu" android:text="⋮" android:textSize="20sp"
                    android:textColor="#FFFFFF" android:background="@drawable/bg_icon_btn"
                    android:gravity="center" android:layout_marginStart="8dp"
                    android:clickable="true" android:focusable="true"
                    android:layout_width="38dp" android:layout_height="38dp" />
            </LinearLayout>

            <!-- Greeting row with avatar -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="22dp">
                <com.google.android.material.card.MaterialCardView
                    app:cardCornerRadius="26dp" app:cardElevation="0dp" app:cardBackgroundColor="#33FFFFFF"
                    android:layout_width="52dp" android:layout_height="52dp">
                    <TextView android:id="@+id/tvAvatar" android:gravity="center" android:textColor="#FFFFFF"
                        android:textSize="20sp" android:textStyle="bold"
                        android:layout_width="match_parent" android:layout_height="match_parent" />
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="14dp">
                    <TextView android:text="Welcome back" android:textColor="#CCFFFFFF" android:textSize="14sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvName" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvDate" android:textColor="#CCFFFFFF" android:textSize="13sp" android:layout_marginTop="1dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- Clock pill -->
            <LinearLayout android:background="@drawable/bg_pill_translucent" android:orientation="horizontal"
                android:gravity="center_vertical" android:layout_marginTop="18dp"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="10dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextClock android:format12Hour="hh:mm:ss a" android:format24Hour="hh:mm:ss a"
                    android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Today's status -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="-48dp"
            app:cardCornerRadius="20dp" app:cardElevation="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp">
                <com.google.android.material.card.MaterialCardView
                    app:cardCornerRadius="27dp" app:cardElevation="0dp" app:cardBackgroundColor="#EEF2FF"
                    android:layout_width="54dp" android:layout_height="54dp">
                    <TextView android:text="📍" android:textSize="24sp" android:gravity="center"
                        android:layout_width="match_parent" android:layout_height="match_parent" />
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="14dp">
                    <TextView android:text="TODAY'S STATUS" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/muted"
                        android:letterSpacing="0.05"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvStatus" android:text="Checking..." android:textSize="19sp" android:textStyle="bold"
                        android:textColor="@color/ink" android:layout_marginTop="2dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvMonth" android:textColor="@color/muted" android:textSize="13sp" android:layout_marginTop="3dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Leave balance strip -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#EEF2FF">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:text="🌴" android:textSize="18sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvLeaveBal" android:textColor="@color/primary" android:textStyle="bold" android:textSize="13sp"
                    android:layout_marginStart="8dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mark Attendance (hero CTA) -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/tileAttendance"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="16dp"
            android:clickable="true" android:focusable="true"
            app:cardBackgroundColor="@color/primary" app:cardCornerRadius="20dp" app:cardElevation="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal" android:padding="20dp">
                <com.google.android.material.card.MaterialCardView
                    app:cardCornerRadius="27dp" app:cardElevation="0dp" app:cardBackgroundColor="#26FFFFFF"
                    android:layout_width="54dp" android:layout_height="54dp">
                    <TextView android:text="📸" android:textSize="26sp" android:gravity="center"
                        android:layout_width="match_parent" android:layout_height="match_parent" />
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView android:text="Mark Attendance" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:text="Selfie · Location · Time" android:textColor="#CCFFFFFF" android:textSize="13sp"
                        android:layout_marginTop="1dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <TextView android:text="›" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Secondary actions grid -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView android:id="@+id/tileLeave"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_margin="4dp" android:layout_marginTop="12dp" android:clickable="true" android:focusable="true"
                app:cardCornerRadius="20dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="20dp">
                    <com.google.android.material.card.MaterialCardView
                        app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="#FEF3C7"
                        android:layout_width="48dp" android:layout_height="48dp">
                        <TextView android:text="🌴" android:textSize="22sp" android:gravity="center"
                            android:layout_width="match_parent" android:layout_height="match_parent" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:text="Leave" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/ink"
                        android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/tileNight"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_margin="4dp" android:layout_marginTop="12dp" android:clickable="true" android:focusable="true"
                app:cardCornerRadius="20dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="20dp">
                    <com.google.android.material.card.MaterialCardView
                        app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="#E0E7FF"
                        android:layout_width="48dp" android:layout_height="48dp">
                        <TextView android:text="🌙" android:textSize="22sp" android:gravity="center"
                            android:layout_width="match_parent" android:layout_height="match_parent" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:text="Night Hold" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/ink"
                        android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/tileCalendar"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_margin="4dp" android:layout_marginTop="12dp" android:clickable="true" android:focusable="true"
                app:cardCornerRadius="20dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="20dp">
                    <com.google.android.material.card.MaterialCardView
                        app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="#DBEAFE"
                        android:layout_width="48dp" android:layout_height="48dp">
                        <TextView android:text="📅" android:textSize="22sp" android:gravity="center"
                            android:layout_width="match_parent" android:layout_height="match_parent" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:text="Calendar" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/ink"
                        android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- My Team (managers only) -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/tileTeam" android:visibility="gone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp"
            android:clickable="true" android:focusable="true"
            app:cardCornerRadius="20dp" app:cardElevation="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <com.google.android.material.card.MaterialCardView
                    app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="#EDE9FE"
                    android:layout_width="48dp" android:layout_height="48dp">
                    <TextView android:text="👥" android:textSize="22sp" android:gravity="center"
                        android:layout_width="match_parent" android:layout_height="match_parent" />
                </com.google.android.material.card.MaterialCardView>
                <TextView android:text="My Team" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/ink"
                    android:layout_marginStart="14dp" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" />
                <TextView android:text="›" android:textColor="@color/muted" android:textSize="26sp" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
