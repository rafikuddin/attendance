<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="20dp">

            <!-- Header -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_header" android:orientation="vertical"
                android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="40dp" android:paddingBottom="60dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <com.google.android.material.card.MaterialCardView
                        app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="#33FFFFFF"
                        android:layout_width="48dp" android:layout_height="48dp">
                        <TextView android:id="@+id/tvAvatar" android:gravity="center" android:textColor="#FFFFFF"
                            android:textSize="20sp" android:textStyle="bold"
                            android:layout_width="match_parent" android:layout_height="match_parent" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:text="SAM BOND" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="26sp"
                        android:letterSpacing="0.03" android:layout_marginStart="12dp"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/btnRefresh" android:text="⟳" android:textSize="22sp"
                        android:textColor="#FFFFFF" android:background="@drawable/bg_icon_btn"
                        android:gravity="center" android:clickable="true" android:focusable="true"
                        android:layout_width="42dp" android:layout_height="42dp" />
                    <TextView android:id="@+id/btnMenu" android:text="👤" android:textSize="18sp"
                        android:textColor="#FFFFFF" android:background="@drawable/bg_icon_btn"
                        android:gravity="center" android:layout_marginStart="8dp"
                        android:clickable="true" android:focusable="true"
                        android:layout_width="42dp" android:layout_height="42dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="20dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:text="Welcome back" android:textColor="#B3FFFFFF" android:textSize="13sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tvName" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tvDate" android:textColor="#B3FFFFFF" android:textSize="13sp" android:layout_marginTop="1dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <LinearLayout android:background="@drawable/bg_pill_translucent" android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextClock android:format12Hour="hh:mm a" android:format24Hour="hh:mm a"
                            android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <View android:background="@drawable/bg_sheet_top"
                android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="-30dp" />

            <!-- Today's status -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="-34dp"
                app:cardCornerRadius="24dp" app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp">
                    <com.google.android.material.card.MaterialCardView
                        app:cardCornerRadius="26dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/accent_soft"
                        android:layout_width="52dp" android:layout_height="52dp">
                        <TextView android:text="📍" android:textSize="24sp" android:gravity="center"
                            android:layout_width="match_parent" android:layout_height="match_parent" />
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginStart="14dp">
                        <TextView android:text="TODAY'S STATUS" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/muted"
                            android:letterSpacing="0.08"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tvStatus" android:text="Checking..." android:textSize="19sp" android:textStyle="bold"
                            android:textColor="@color/ink" android:layout_marginTop="2dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tvMonth" android:textColor="@color/muted" android:textSize="13sp" android:layout_marginTop="3dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Leave balance -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginStart="22dp" android:layout_marginEnd="22dp" android:layout_marginTop="22dp">
                <TextView android:id="@+id/tvBalHeading" android:text="LEAVE BALANCE" android:textSize="13sp" android:textStyle="bold"
                    android:textColor="@color/primary" android:letterSpacing="0.08"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvBalUsed" android:text="Used 0" android:textSize="13sp" android:textColor="@color/muted"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="8dp"
                app:cardCornerRadius="24dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="0dp">
                    <ProgressBar android:id="@+id/pbCasual" style="?android:attr/progressBarStyleHorizontal"
                        android:indeterminate="false" android:max="100" android:progress="0"
                        android:progressDrawable="@drawable/bar_casual"
                        android:layout_width="match_parent" android:layout_height="40dp" />
                    <TextView android:id="@+id/tvCasual" android:text="Casual" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/ink"
                        android:layout_gravity="center_vertical|start" android:layout_marginStart="16dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvCasualVal" android:text="-" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/ink"
                        android:layout_gravity="center_vertical|end" android:layout_marginEnd="16dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="10dp">
                    <ProgressBar android:id="@+id/pbSick" style="?android:attr/progressBarStyleHorizontal"
                        android:indeterminate="false" android:max="100" android:progress="0"
                        android:progressDrawable="@drawable/bar_sick"
                        android:layout_width="match_parent" android:layout_height="40dp" />
                    <TextView android:id="@+id/tvSick" android:text="Sick" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/ink"
                        android:layout_gravity="center_vertical|start" android:layout_marginStart="16dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvSickVal" android:text="-" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/ink"
                        android:layout_gravity="center_vertical|end" android:layout_marginEnd="16dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="10dp">
                    <ProgressBar android:id="@+id/pbEarn" style="?android:attr/progressBarStyleHorizontal"
                        android:indeterminate="false" android:max="100" android:progress="0"
                        android:progressDrawable="@drawable/bar_earn"
                        android:layout_width="match_parent" android:layout_height="40dp" />
                    <TextView android:id="@+id/tvEarn" android:text="Earn" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/ink"
                        android:layout_gravity="center_vertical|start" android:layout_marginStart="16dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvEarnVal" android:text="-" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/ink"
                        android:layout_gravity="center_vertical|end" android:layout_marginEnd="16dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick actions -->
            <TextView android:text="QUICK ACTIONS" android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/primary" android:letterSpacing="0.08"
                android:layout_marginStart="22dp" android:layout_marginTop="22dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />

            <com.google.android.material.card.MaterialCardView android:id="@+id/tileAttendance"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="8dp"
                android:clickable="true" android:focusable="true"
                app:cardBackgroundColor="@color/primary" app:cardCornerRadius="26dp" app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:text="📸" android:textSize="26sp" android:gravity="center"
                            android:background="@drawable/bg_icon_btn"
                            android:layout_width="54dp" android:layout_height="54dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:layout_marginStart="14dp" android:orientation="vertical">
                            <TextView android:text="Mark Attendance" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            <TextView android:text="Selfie · Location · Time" android:textColor="#B3FFFFFF" android:textSize="13sp"
                                android:layout_marginTop="1dp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/btnMark" android:text="Take selfie &amp; submit  →" android:textColor="#FFFFFF"
                        android:textStyle="bold" android:textSize="16sp" android:gravity="center"
                        android:background="@drawable/bg_btn_coral"
                        android:layout_marginTop="16dp"
                        android:layout_width="match_parent" android:layout_height="52dp" />
                    <TextView android:id="@+id/tvTodayLoc" android:text="📍 Location is captured when you mark attendance"
                        android:textColor="#E6FFFFFF" android:textSize="13sp" android:maxLines="2"
                        android:background="@drawable/bg_loc_strip"
                        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp"
                        android:layout_marginTop="12dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@drawable/bg_nav" android:elevation="12dp"
        android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="4dp">
    <LinearLayout android:id="@+id/navHome" android:orientation="vertical" android:gravity="center_horizontal"
        android:clickable="true" android:focusable="true"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="8dp">
        <View android:background="@drawable/bg_dot" android:layout_width="22dp" android:layout_height="4dp" android:layout_marginBottom="4dp" />
        <TextView android:text="🏠" android:textSize="22sp" android:alpha="1"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Home" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/primary"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/navLeave" android:orientation="vertical" android:gravity="center_horizontal"
        android:clickable="true" android:focusable="true"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="8dp">
        <View android:layout_width="22dp" android:layout_height="4dp" android:layout_marginBottom="4dp" />
        <TextView android:text="🌴" android:textSize="22sp" android:alpha="0.6"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Leave" android:textSize="11sp" android:textStyle="normal" android:textColor="@color/muted"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/navTeam" android:orientation="vertical" android:gravity="center_horizontal"
        android:clickable="true" android:focusable="true" android:visibility="gone"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="8dp">
        <View android:layout_width="22dp" android:layout_height="4dp" android:layout_marginBottom="4dp" />
        <TextView android:text="👥" android:textSize="22sp" android:alpha="0.6"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Team" android:textSize="11sp" android:textStyle="normal" android:textColor="@color/muted"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/navCalendar" android:orientation="vertical" android:gravity="center_horizontal"
        android:clickable="true" android:focusable="true"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="8dp">
        <View android:layout_width="22dp" android:layout_height="4dp" android:layout_marginBottom="4dp" />
        <TextView android:text="📅" android:textSize="22sp" android:alpha="0.6"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Calendar" android:textSize="11sp" android:textStyle="normal" android:textColor="@color/muted"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/navNight" android:orientation="vertical" android:gravity="center_horizontal"
        android:clickable="true" android:focusable="true"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="8dp">
        <View android:layout_width="22dp" android:layout_height="4dp" android:layout_marginBottom="4dp" />
        <TextView android:text="🌙" android:textSize="22sp" android:alpha="0.6"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Night" android:textSize="11sp" android:textStyle="normal" android:textColor="@color/muted"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
