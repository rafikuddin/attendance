<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Attendance" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@color/sky_top</item>
        <item name="materialButtonStyle">@style/Btn</item>
        <item name="materialCardViewStyle">@style/GlassCard</item>
    </style>
    <!-- Frosted white card: big soft corners, a light edge, gentle shadow -->
    <style name="GlassCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/glass</item>
        <item name="strokeColor">@color/glass_edge</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <!-- Main buttons: indigo pill. Greys out automatically when disabled. -->
    <style name="Btn" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/btn_accent_tint</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">56dp</item>
    </style>
    <!-- White glossy pill with dark text (like Send / Request in the concept) -->
    <style name="BtnWhite" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@android:color/white</item>
        <item name="android:textColor">@color/ink</item>
        <item name="rippleColor">#331E2247</item>
        <item name="cornerRadius">30dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:elevation">4dp</item>
    </style>
    <style name="BtnOutline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">28dp</item>
        <item name="strokeColor">@color/accent</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">56dp</item>
    </style>
</resources>
